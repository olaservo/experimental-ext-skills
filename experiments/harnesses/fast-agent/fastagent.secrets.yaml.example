# FastAgent secrets — copy to fastagent.secrets.yaml.
#
# Two ways to populate:
#   (a) Keep the ${VAR} references and source experiments/.env before running:
#         set -a && . "$AGENT_SKILLS_ENV_FILE" && set +a
#       (run-scenario already does this for the hf-mcp-server launch.)
#   (b) Replace each ${VAR} with a literal API key.
#
# fastagent.secrets.yaml is gitignored — never commit literal keys.
#
# GEMINI_API_KEY is the env-var the gemini-cli harness already uses;
# reusing it here means no new env-var is needed for fast-agent's
# `google` variant.

anthropic:
  api_key: ${ANTHROPIC_API_KEY}
openai:
  api_key: ${OPENAI_API_KEY}
# OpenAI Responses API — required for gpt-5.5 + function tools + reasoning_effort.
# Same key as `openai`, separate fast-agent provider that routes to /v1/responses.
responses:
  api_key: ${OPENAI_API_KEY}
google:
  api_key: ${GEMINI_API_KEY}
openrouter:
  api_key: ${OPENROUTER_API_KEY}
